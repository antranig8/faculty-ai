# Copy to .env and fill in what you need. Never commit .env.

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Bundled into browser JS (not a secret). Must match FACULTY_AI_APP_API_KEY for non-local access.
NEXT_PUBLIC_FACULTY_AI_APP_API_KEY=
# Optional: require an access code before any frontend page loads.
FACULTY_AI_ACCESS_CODE=

# --- Backend access ---
FACULTY_AI_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Required for non-local HTTP/WebSocket access. Localhost works without it.
FACULTY_AI_APP_API_KEY=

# --- Speech (Deepgram) ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=flux-general-en
DEEPGRAM_LANGUAGE=en-US

# --- LLM (Groq). Set FACULTY_AI_LLM_PROVIDER=groq and GROQ_API_KEY to enable; otherwise heuristics are used. ---
GROQ_API_KEY=
FACULTY_AI_LLM_PROVIDER=heuristic
FACULTY_AI_LLM_MODEL=qwen/qwen3-32b
FACULTY_AI_REPHRASE_MODEL=qwen/qwen3-8b
